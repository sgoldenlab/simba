   (function () {
     var root = document.getElementById("simbaCite");
     if (!root) return;
     var outs = root.querySelectorAll(".simba-cite-out"), tabs = root.querySelectorAll("[role=tab]");
     var copyBtn = root.querySelector(".simba-cite-copy");
     // the raw block is indented for RST; strip that indent once from the shown/copied text
     outs.forEach(function (o) { o.textContent = o.textContent.replace(/^ {3}/gm, ""); });
     function text(fmt) { return root.querySelector('.simba-cite-out[data-fmt="' + fmt + '"]').textContent; }
     var current = "apa";
     tabs.forEach(function (tab) {
       tab.addEventListener("click", function () {
         current = tab.dataset.fmt;
         tabs.forEach(function (t) { t.setAttribute("aria-selected", t === tab ? "true" : "false"); });
         outs.forEach(function (o) { o.hidden = o.dataset.fmt !== current; });
         copyBtn.textContent = "Copy";
       });
     });
     function flash(label, cls) {
       copyBtn.textContent = label; copyBtn.classList.add(cls);
       setTimeout(function () { copyBtn.textContent = "Copy"; copyBtn.classList.remove(cls); }, 2200);
     }
     // execCommand fallback for non-secure contexts; if that fails too, select the text
     // so the reader can press Ctrl+C themselves
     function fallbackCopy(s) {
       var ta = document.createElement("textarea"), ok = false;
       ta.value = s; ta.style.position = "fixed"; ta.style.opacity = "0";
       document.body.appendChild(ta); ta.select();
       try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
       document.body.removeChild(ta);
       if (ok) return flash("Copied ✓", "ok");
       var range = document.createRange();
       range.selectNodeContents(root.querySelector('.simba-cite-out[data-fmt="' + current + '"]'));
       var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
       flash("Press Ctrl+C", "sel");
     }
     copyBtn.addEventListener("click", function () {
       var s = text(current);
       if (navigator.clipboard && window.isSecureContext) {
         navigator.clipboard.writeText(s).then(function () { flash("Copied ✓", "ok"); },
                                               function () { fallbackCopy(s); });
       } else { fallbackCopy(s); }
     });
     root.querySelectorAll("[data-dl]").forEach(function (a) {
       var fmt = a.dataset.dl, mime = fmt === "bib" ? "application/x-bibtex" : "application/x-research-info-systems";
